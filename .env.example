# Copy to .env and fill in. Never commit .env.
#
# Choose ONE backend.
# 1) Gemini API with an API key:
GEMINI_API_KEY=
# 2) Gemini on Google Cloud (Vertex AI), using Google Cloud credits. No key: credentials come from
#    Application Default Credentials (`gcloud auth application-default login` on a laptop, the
#    service account on Cloud Run). When this is true it wins over GEMINI_API_KEY.
GOOGLE_GENAI_USE_ENTERPRISE=false
GOOGLE_CLOUD_PROJECT=
# "global" serves the newest models; a region such as us-central1 also works.
GOOGLE_CLOUD_LOCATION=global
#
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated models tried in order when GEMINI_MODEL is not found, overloaded (503)
# or over your quota (429). Quotas are per model. See which models your key can use:
#   python tools/list_models.py --ping
GEMINI_FALLBACK_MODEL=gemini-flash-latest,gemini-flash-lite-latest
# live calls Gemini; fixture serves answer-key data for the test charts. Default: live if credentials are set.
APP_MODE=
SESSION_TTL_MINUTES=60
DATA_DIR=./.data
PORT=8000
# Fixture mode only: seconds to pause after each pipeline step so the progress view is visible in a demo.
FIXTURE_STEP_DELAY=0.4
# Parallel Gemini requests. Lower it if you see "high demand" (503) or rate-limit (429) errors.
GEMINI_MAX_CONCURRENCY=4
# 1 asks Gemini for chart boxes in single images too (one extra request per upload).
# Off by default: an uploaded image is read whole.
DETECT_IN_IMAGES=0

# Limits for a public deployment (0 turns a limit off). Per visitor per hour, and new files per day.
LIMIT_DOCUMENTS_PER_HOUR=20
LIMIT_QUESTIONS_PER_HOUR=120
LIMIT_RETRIES_PER_HOUR=30
LIMIT_DOCUMENTS_PER_DAY=500

# Saved live readings served read-only (comma-separated folders). Default: app/demo_cache, the built-in samples.
# SEED_CACHE_DIRS=app/demo_cache
